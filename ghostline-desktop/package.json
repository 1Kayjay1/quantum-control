{
  "name": "ghostline-desktop",
  "version": "1.0.0",
  "description": "Ghostline CoDrone EDU Route Optimizer - Portable Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prepare": "node scripts/prepare-build.js",
    "build:win": "electron-builder --win portable",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.ghostline.desktop",
    "productName": "Ghostline",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "extraResources": [
      {
        "from": "python-runtime",
        "to": "python-runtime",
        "filter": ["**/*"]
      },
      {
        "from": "../ghostline-backend",
        "to": "backend",
        "filter": ["*.py", "requirements.txt"]
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "assets/**/*"
    ]
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
